# Versiones de las imágenes
NGINX_VERSION=1.28.0
PHPMYADMIN_VERSION=5.2.2
MYSQL_VERSION=8.0

# Puerto publicado de Nginx
NGINX_PORT=80

# Ruta del archivo de configuración de Nginx en el host

NGINX_CONFIG_PATH=./nginx/default.conf

# Configuración inicial de MySQL
MYSQL_ROOT_PASSWORD=PASS1234
MYSQL_DATABASE=prueba
MYSQL_USER=admin
MYSQL_PASSWORD=admin

# Conexión de phpMyAdmin con MySQL

PMA_PORT=3306
